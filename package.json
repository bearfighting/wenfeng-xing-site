{
  "name": "astro-navfolio",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "fonts:ui": "bun scripts/fonts/subset-ui-font.ts",
    "build": "bun run fonts:ui && astro build && pagefind --site dist --output-subdir pagefind --root-selector main --exclude-selectors \"[data-pagefind-ignore]\"",
    "preview": "astro preview",
    "docs:dev": "NAVFOLIO_CONTENT_SOURCE=docs astro dev",
    "docs:build": "NAVFOLIO_CONTENT_SOURCE=docs bun run build",
    "docs:preview": "NAVFOLIO_CONTENT_SOURCE=docs astro preview",
    "docs:sync": "git submodule update --init --recursive",
    "astro": "astro",
    "post:new": "bun scripts/new-content.ts blog",
    "vibe:new": "bun scripts/new-content.ts vibe",
    "lint": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "bun run lint && prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource/maple-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@traceleaf/browser": "file:traceleaf-browser-1.0.0.tgz",
    "astro": "^7.3.8",
    "astro-expressive-code": "^0.44.2",
    "katex": "^0.19.0",
    "@lucide/astro": "^1.54.0",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint-plugin-deprecation": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "bun run format:check"
  }
}
